      }
    },
    "/api/v1/verify/entity": {
      "post": {
        "tags": [
          "verify"
        ],
        "summary": "Verify Entity",
        "operationId": "verify_entity_api_v1_verify_entity_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AdvisorVerificationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/draft": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Create Draft",
        "operationId": "create_draft_api_v1_reports_draft_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IncidentDraftRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "List Drafts",
        "operationId": "list_drafts_api_v1_reports_draft_get",
        "parameters": [
          {
            "name": "user_session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/draft/{draft_id}": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Get Draft",
        "operationId": "get_draft_api_v1_reports_draft__draft_id__get",
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Draft Id"
            }
          },
          {
            "name": "user_session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IncidentDraftResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "reports"
        ],
        "summary": "Delete Draft",
        "operationId": "delete_draft_api_v1_reports_draft__draft_id__delete",
        "parameters": [
          {
            "name": "draft_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Draft Id"
            }
          },
          {
            "name": "user_session_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "title": "User Session Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/reports/routes": {
      "get": {
        "tags": [
          "reports"
        ],
        "summary": "Reporting Routes",
        "operationId": "reporting_routes_api_v1_reports_routes_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/education/modules": {
      "get": {
        "tags": [
          "education"
        ],
        "summary": "Get Modules",
        "operationId": "get_modules_api_v1_education_modules_get",
        "parameters": [
          {
            "name": "language",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "default": "en",
              "title": "Language"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/status": {
      "get": {
        "tags": [
          "sources"
        ],
        "summary": "Source Status",
        "description": "Transparency endpoint: what sources exist, their mode, and freshness.\n\nEvery served snapshot is checksummed and appended to source_records, so\nthe provenance shown on /about is auditable rather than claimed.",
        "operationId": "source_status_api_v1_sources_status_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/api/v1/sources/records": {
      "get": {
        "tags": [
          "sources"
        ],
        "summary": "Source Records",
        "description": "Audit trail of served source snapshots (most recent first).",
        "operationId": "source_records_api_v1_sources_records_get",
        "parameters": [
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "default": 20,
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health Check",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/ready": {
      "get": {
        "summary": "Ready Check",
        "operationId": "ready_check_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdvisorVerificationRequest": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "registration_number": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 50
              },
              {
                "type": "null"
              }
            ],
            "title": "Registration Number"
          },
          "firm_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ],
            "title": "Firm Name"
          }
        },
        "type": "object",
        "title": "AdvisorVerificationRequest"
      },
      "AnalysisRequest": {
        "properties": {
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          },
          "language": {
            "type": "string",
            "pattern": "^(en|ta|hi|te|ml|kn)$",
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "content"
        ],
        "title": "AnalysisRequest"
      },
      "AnalysisResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "red_flags": {
            "items": {
              "$ref": "#/components/schemas/RedFlag"
            },
            "type": "array",
            "title": "Red Flags"
          },
          "what_we_verified": {
            "items": {
              "$ref": "#/components/schemas/VerifiedSource"
            },
            "type": "array",
            "title": "What We Verified"
          },
          "safe_next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Safe Next Steps"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "risk_level",
          "summary",
          "red_flags",
          "what_we_verified",
          "safe_next_steps",
          "limitations",
          "created_at"
        ],
        "title": "AnalysisResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentDraftRequest": {
        "properties": {
          "user_session_id": {
            "type": "string",
            "maxLength": 64,
            "title": "User Session Id"
          },
          "content": {
            "type": "string",
            "maxLength": 10000,
            "minLength": 1,
            "title": "Content"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 2000
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "consent_storage": {
            "type": "boolean",
            "title": "Consent Storage",
            "description": "Explicit consent required before anything is stored",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "user_session_id",
          "content"
        ],
        "title": "IncidentDraftRequest"
      },
      "IncidentDraftResponse": {
        "properties": {
          "draft_id": {
            "type": "string",
            "title": "Draft Id"
          },
          "redacted_content": {
            "type": "string",
            "title": "Redacted Content"
          },
          "notes": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Notes"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time",
            "title": "Expires At"
          },
          "retention_note": {
            "type": "string",
            "title": "Retention Note"
          }
        },
        "type": "object",
        "required": [
          "draft_id",
          "redacted_content",
          "notes",
          "created_at",
          "expires_at",
          "retention_note"
        ],
        "title": "IncidentDraftResponse"
      },
      "RedFlag": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "label": {
            "type": "string",
            "title": "Label"
          },
          "explanation": {
            "type": "string",
            "title": "Explanation"
          },
          "matched_text": {
            "type": "string",
            "title": "Matched Text"
          },
          "severity": {
            "type": "string",
            "title": "Severity",
            "description": "high | medium | low — heuristic weight, never a probability"
          }
        },
        "type": "object",
        "required": [
          "code",
          "label",
          "explanation",
          "matched_text",
          "severity"
        ],
        "title": "RedFlag"
      },
      "RiskLevel": {
        "type": "string",
        "enum": [
          "high",
          "review_carefully",
          "no_obvious_red_flags"
        ],
        "title": "RiskLevel"
      },
      "UrlAnalysisRequest": {
        "properties": {
          "url": {
            "type": "string",
            "maxLength": 2048,
            "minLength": 1,
            "title": "Url"
          },
          "language": {
            "type": "string",
            "pattern": "^(en|ta|hi|te|ml|kn)$",
            "title": "Language",
            "default": "en"
          }
        },
        "type": "object",
        "required": [
          "url"
        ],
        "title": "UrlAnalysisRequest"
      },
      "UrlAnalysisResponse": {
        "properties": {
          "analysis_id": {
            "type": "string",
            "title": "Analysis Id"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "red_flags": {
            "items": {
              "$ref": "#/components/schemas/RedFlag"
            },
            "type": "array",
            "title": "Red Flags"
          },
          "safe_next_steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Safe Next Steps"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "note": {
            "type": "string",
            "title": "Note",
            "default": "This check is a static pattern review. The page was not opened or fetched."
          }
        },
        "type": "object",
        "required": [
          "analysis_id",
          "risk_level",
          "summary",
          "red_flags",
          "safe_next_steps",
          "limitations",
          "created_at"
        ],
        "title": "UrlAnalysisResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "VerificationResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status",
            "description": "verified | not_found | unavailable — 'not_found' is NOT proof of fraud"
          },
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "retrieved_at": {
            "type": "string",
            "format": "date-time",
            "title": "Retrieved At"
          },
          "match_quality": {
            "type": "string",
            "title": "Match Quality"
          },
          "matched_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Matched Name"
          },
          "uncertainty_note": {
            "type": "string",
            "title": "Uncertainty Note"
          }
        },
        "type": "object",
        "required": [
          "status",
          "source_name",
          "source_url",
          "retrieved_at",
          "match_quality",
          "uncertainty_note"
        ],
        "title": "VerificationResponse"
      },
      "VerifiedSource": {
        "properties": {
          "source_name": {
            "type": "string",
            "title": "Source Name"
          },
          "source_url": {
            "type": "string",
            "title": "Source Url"
          },
          "status": {
            "type": "string",
            "title": "Status",
            "description": "verified | not_checked_in_demo | unavailable"
          },
          "retrieved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Retrieved At"
          }
        },
        "type": "object",
        "required": [
          "source_name",
          "source_url",
          "status"
        ],
        "title": "VerifiedSource"
      }
    }
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local demo"
    }
  ]
}