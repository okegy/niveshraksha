# ---------------------------------------------------------------------------
# NiveshRaksha environment template — copy to .env and adjust. NEVER commit .env
# The demo needs NO secrets: all sources run in mock/static mode.
# ---------------------------------------------------------------------------

# Frontend -------------------------------------------------------------------
# Base URL of the FastAPI backend, as reachable from the user's browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend --------------------------------------------------------------------
# SQLite file used by the demo (created automatically).
NIVESHRAKSHA_DB_PATH=./data/niveshraksha.db

# For a PostgreSQL-backed run instead of SQLite:
# NIVESHRAKSHA_DATABASE_URL=postgresql+psycopg2://nivesh:nivesh@localhost:5432/niveshraksha

# Hours before stored analyses / incident drafts are hard-deleted.
NIVESHRAKSHA_RETENTION_HOURS=72

# Frontend container (docker compose) ----------------------------------------
# Where the browser can reach the backend when running under Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Optional AI/voice keys (v2 agentic build) — put REAL values in backend/.env
# (gitignored). Never commit real keys. Adapters degrade gracefully when
# absent, and /api/v1/chat/status + /api/v1/voice/status report honest state.
# ---------------------------------------------------------------------------
# Sarvam AI (voice TTS/STT) — https://dashboard.sarvam.ai
SARVAM_API_KEY=
# xAI Grok (OpenAI-compatible LLM synthesis layer)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-fast-non-reasoning
# Xiaomi MiMo (OpenAI-compatible LLM synthesis layer)
MIMO_API_KEY=
MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
MIMO_MODEL=MiMo-V2.5
# Server-side secret for deriving per-browser encryption keys of chat history
CHAT_HISTORY_SERVER_SECRET=change-me-in-production
