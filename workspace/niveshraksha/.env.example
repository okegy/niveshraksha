# ---------------------------------------------------------------------------
# NiveshRaksha environment template — copy to .env and adjust. NEVER commit .env
# The demo needs NO secrets: all sources run in mock/static mode.
# ---------------------------------------------------------------------------

# Frontend -------------------------------------------------------------------
# Base URL of the FastAPI backend, as reachable from the user's browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Backend --------------------------------------------------------------------
# SQLite file used by the demo (created automatically).
NIVESHRAKSHA_DB_PATH=./data/niveshraksha.db

# For a PostgreSQL-backed run instead of SQLite:
# NIVESHRAKSHA_DATABASE_URL=postgresql+psycopg2://nivesh:nivesh@localhost:5432/niveshraksha

# Hours before stored analyses / incident drafts are hard-deleted.
NIVESHRAKSHA_RETENTION_HOURS=72

# Frontend container (docker compose) ----------------------------------------
# Where the browser can reach the backend when running under Docker.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
